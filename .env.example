# Copy to .env for local runs outside docker-compose.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=simula
REDIS_URL=redis://localhost:6379/0

# MUST be the publicly reachable URL: it is baked into rendered creatives so
# the click tracker can call back.
API_URL=http://localhost:8080
API_KEY=dev-key

# Without a key the service still serves ads, using each ad set's fallback_copy.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_TIMEOUT_S=2.5

SESSION_IDLE_TTL_S=30
CAMPAIGN_CACHE_TTL_S=10800

TEMPORAL_TARGET=localhost:7233
TEMPORAL_NAMESPACE=default
# TEMPORAL_API_KEY=   # set for Temporal Cloud (implies TLS)
